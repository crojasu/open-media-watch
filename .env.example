# Copy to .env and fill in. All values below are fake placeholders.

# Database (SQLite by default, no setup needed; use a postgresql:// URL for production)
DATABASE_URL=sqlite:///data/omw.db

# Reviewer credentials for the write API: "user:password,user2:password2"
# Use long random values, e.g. python -c "import secrets; print(secrets.token_urlsafe(24))"
REVIEW_USERS=CHANGE_ME:use_a_long_random_value

# Primary classifier (required)
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME
# CLAUDE_MODEL=

# Optional fallbacks, tried in this order when the previous provider fails
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
OPENAI_API_KEY=

# Optional cheap pre-filter (Gemini) and embeddings
GEMINI_API_KEY=

# Optional news API keys
GUARDIAN_API_KEY=test

# Taxonomy/prompts and source/keyword configuration (defaults point to the example files)
# OMW_TAXONOMY=examples/taxonomy.example.json
# OMW_SOURCES=examples/sources.example.json

# CORS: comma-separated list of allowed origins (empty = none)
CORS_ORIGINS=

# Optional Telegram alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
